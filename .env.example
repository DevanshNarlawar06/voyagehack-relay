# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:55432/relay
RELAY_ENCRYPTION_KEY=change-me-32-bytes-base64
RELAY_JWT_SECRET=change-me
# Model provider keys (leave empty to use the offline `mock` provider)
LLM_PROVIDER_API_KEY=
# Slack (P1, Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Where connectors find the mock systems (the mocks service in Compose)
RELAY_MOCKS_URL=http://localhost:9000
RELAY_NOTIFY_URL=http://localhost:9000
